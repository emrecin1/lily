# AI Crypto Trading Bot - Environment Variables
# Copy this file to .env and fill in your values.

# =============================================
# Exchange API Credentials (OPTIONAL for V1)
# =============================================
# Public market data does NOT require API keys.
# Only needed if you intend to use authenticated
# endpoints. In V1, LIVE_TRADING is disabled.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# =============================================
# Trading Safety Switches
# =============================================
# MUST remain false in V1. When false, no real
# orders are ever sent to the exchange.
LIVE_TRADING=false