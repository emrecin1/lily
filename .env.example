# AI Crypto Trading Bot - Environment Variables
# Copy this file to .env and fill in your values.  .env ASLA git'e commit edilmez.

# =============================================
# V1 (arastirma pipeline) — src/ , main.py
# =============================================
# Public market data icin API key GEREKMEZ.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# V1 guvenlik anahtari — V1'de daima false kalir.
LIVE_TRADING=false

# =============================================
# V2 (Freqtrade runtime) — config/ , user_data/
# =============================================
# Not: Freqtrade key'leri config/config.testnet.json / config.live.json icinde
# tutulur (bu dosyalar gitignore'da). Asagidakiler yalnizca yardimci scriptler
# (scripts/reconcile.py) ve Telegram icin.

# Binance TESTNET (https://testnet.binance.vision) — sadece trade yetkisi.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance MAINNET — SADECE spot trade. WITHDRAWAL KAPALI. Borsada IP allow-list.
# Yalnizca docs/MIGRATION.md Asama 6'da doldurulur.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram kontrol + alarm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsiyonel: heartbeat izleme (healthchecks.io ping URL'i)
HEALTHCHECK_PING_URL=

# =============================================
# webui/ — FreqUI yerine gecen ozel panel (:8082)
# =============================================
# Panel girisi icin sifre (Freqtrade sifresiyle ILISKILI DEGIL, ayri).
DASHBOARD_PASSWORD=
# Session cookie imzalama anahtari — rastgele uzun bir string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SESSION_SECRET=
# Varsayilan config/config.dry.json; testnet/live'a gecince degistir.
FREQTRADE_CONFIG_PATH=config/config.dry.json
# Not: gunluk-kayip esigi artik burada DEGIL, ilgili FREQTRADE_CONFIG_PATH
# dosyasinin "aicrypto.max_daily_loss_pct" alaninda tutulur (/settings
# sayfasindan degistirilir). WEBUI_DAILY_LOSS_PCT KALDIRILDI.
