{
    "//": "FreqAI overlay. config.dry.json USTUNE bindirilir:",
    "//2": "  freqtrade backtesting -c config/config.dry.json -c config/config.freqai.json --strategy AiCryptoFreqAIStrategy --freqaimodel XGBoostClassifier",
    "//3": "train_period_days/backtest_period_days => backtest'te otomatik walk-forward (haftalik yeniden egitim).",

    "freqai": {
        "enabled": true,
        "identifier": "aicrypto-xgb-v1",
        "train_period_days": 180,
        "backtest_period_days": 7,
        "fit_live_predictions_candles": 300,
        "purge_old_models": 2,
        "save_backtest_models": false,

        "feature_parameters": {
            "include_timeframes": ["4h"],
            "include_corr_pairlist": [],
            "label_period_candles": 4,
            "include_shifted_candles": 0,
            "indicator_periods_candles": [20, 50],
            "plot_feature_importances": 0,
            "DI_threshold": 0,
            "weight_factor": 0,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false,
            "stratify_training_data": 0,
            "buffer_train_data_candles": 0
        },

        "data_split_parameters": {
            "test_size": 0.2,
            "shuffle": false
        },

        "model_training_parameters": {
            "n_estimators": 300,
            "max_depth": 4,
            "learning_rate": 0.03,
            "subsample": 0.8,
            "colsample_bytree": 0.8,
            "verbosity": 0
        }
    }
}
